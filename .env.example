# Copy to .env (gitignored) for local runs. The grader passes DAY1_SALT on the command line.
# NEVER commit the real team salt.
DAY1_SALT=replace-with-team-salt-from-slip

# JWT signing secret for /api/v1 and RBAC tokens
JWT_SECRET=nascon-dev-jwt-secret-change-me

# PostgreSQL
POSTGRES_USER=nascon
POSTGRES_PASSWORD=nascon
POSTGRES_DB=nascon
# Built by docker-compose from the values above; set only when running the API outside compose
DATABASE_URL=postgresql://nascon:nascon@localhost:5432/nascon

# Redis (rate limiting, realtime pub/sub, domain-event stream)
REDIS_URL=redis://localhost:6379/0

# MinIO object store (receipt PDFs)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nasconminio
MINIO_SECRET_KEY=nasconminio-secret
MINIO_BUCKET=receipts
